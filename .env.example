# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cobre_notifier
DB_USER=cobre_user
DB_PASSWORD=cobre_password

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=cobre-notifier-group
KAFKA_CONCURRENCY=3

# JPA Configuration
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_USE_COMMENTS=false

# Flyway Configuration
FLYWAY_ENABLED=true

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_KAFKA=INFO
LOG_LEVEL_HIBERNATE=WARN
LOG_LEVEL_HIBERNATE_BINDER=TRACE

# Notification Configuration
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_INITIAL_DELAY_MS=1000
NOTIFICATION_RETRY_MULTIPLIER=2.0
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_DELAY_MS=60000

# Webhook Configuration
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_CONNECT_TIMEOUT_MS=3000

# Server Configuration
SERVER_PORT=8080

# Swagger Configuration
SWAGGER_ENABLED=true
