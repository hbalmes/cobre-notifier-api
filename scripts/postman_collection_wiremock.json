{
	"info": {
		"_postman_id": "cobre-wiremock-tests",
		"name": "Cobre Notifier - WireMock Testing",
		"description": "Collection para probar diferentes escenarios de webhook usando WireMock",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "CLIENT001 - Éxito (200 OK)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has event_id\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('event_id');",
							"    pm.expect(jsonData.status).to.eql('published');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"client_id\": \"CLIENT001\",\n  \"event_type\": \"credit_card_payment\",\n  \"content\": \"{\\\"amount\\\": 150.00, \\\"currency\\\": \\\"USD\\\", \\\"transaction_id\\\": \\\"TXN-001\\\"}\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/v1/events",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"v1",
						"events"
					]
				},
				"description": "Envía un evento para CLIENT001 que debería entregarse exitosamente (WireMock responde 200 OK)"
			},
			"response": []
		},
